{
  "expo": {
    "name": "D&D 5e Grimório",
    "slug": "p2-aplicativos-hibridos",
    "scheme": "dnd5e-grimorio",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.franciscobigio.dnd5egrimorio"
    },
    "android": {
      "package": "com.franciscobigio.dnd5egrimorio",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fbbd0e73-fe30-4450-8b03-1f7087384b96"
      }
    }
  }
}
